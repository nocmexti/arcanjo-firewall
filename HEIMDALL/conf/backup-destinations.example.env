# Politica de backup HEIMDALL

HEIMDALL_BACKUP_DIR=/data/backups
HEIMDALL_BACKUP_TARGET=local

# FTP / FTPS
HEIMDALL_BACKUP_FTP_URL=
HEIMDALL_BACKUP_FTP_USER=
HEIMDALL_BACKUP_FTP_PASSWORD=

# S3
HEIMDALL_BACKUP_S3_BUCKET=
HEIMDALL_BACKUP_S3_REGION=
HEIMDALL_BACKUP_S3_ACCESS_KEY_ID=
HEIMDALL_BACKUP_S3_SECRET_ACCESS_KEY=

# Google Drive
HEIMDALL_BACKUP_GOOGLE_DRIVE_FOLDER_ID=
HEIMDALL_BACKUP_GOOGLE_APPLICATION_CREDENTIALS=

# OneDrive
HEIMDALL_BACKUP_ONEDRIVE_FOLDER_ID=
HEIMDALL_BACKUP_ONEDRIVE_TENANT_ID=
HEIMDALL_BACKUP_ONEDRIVE_CLIENT_ID=
HEIMDALL_BACKUP_ONEDRIVE_CLIENT_SECRET=
