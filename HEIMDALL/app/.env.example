SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Local-only mode: bypasses Supabase Auth and uses in-memory demo data.
LOCAL_DEMO_MODE=false
VITE_LOCAL_DEMO_MODE=false

# Use "mock" for development or "restapi" to call real pfSense devices.
PFSENSE_PROVIDER=mock

# Required when saving real pfSense API keys.
# Use a long random value and keep it stable; changing it makes existing secrets unreadable.
PFSENSE_CRED_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional timeout for each pfSense REST call.
PFSENSE_REQUEST_TIMEOUT_MS=15000

# Persistent backup path inside the container. Mount this to a host directory.
HEIMDALL_BACKUP_DIR=/data/backups

# Optional V2 backup target policy. Local persistence is active; remote targets need credentials.
HEIMDALL_BACKUP_TARGET=local
HEIMDALL_BACKUP_FTP_URL=
HEIMDALL_BACKUP_S3_BUCKET=
HEIMDALL_BACKUP_GOOGLE_DRIVE_FOLDER_ID=
HEIMDALL_BACKUP_ONEDRIVE_FOLDER_ID=
